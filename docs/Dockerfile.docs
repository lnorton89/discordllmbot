FROM node:25-alpine

WORKDIR /usr/src/app

# Copy all package.json files for workspaces
COPY package*.json ./
COPY bot/package*.json ./bot/
COPY dashboard/package*.json ./dashboard/
COPY shared/package*.json ./shared/
COPY docs/package*.json ./docs/

# Install dependencies for all workspaces
RUN npm install
RUN apk add --no-cache curl

# Copy turbo configuration
COPY turbo.json ./

# Copy shared and bot workspaces (needed for doc generation)
COPY shared/ ./shared/
COPY bot/ ./bot/

# Build shared workspace first
RUN npx turbo run build --filter=@discordllmbot/shared

# Copy docs source
COPY docs/ ./docs/

# Generate docs with turbo (uses cache)
RUN npx turbo run docs:generate

WORKDIR /usr/src/app/docs

EXPOSE 5174

CMD ["npx", "turbo", "run", "dev", "--filter=discordllmbot-docs"]