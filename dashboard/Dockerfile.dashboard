FROM oven/bun:1.2.14-alpine

WORKDIR /usr/src/app

# Copy all package.json files for workspaces
COPY package.json ./
COPY bot/package.json ./bot/
COPY dashboard/package.json ./dashboard/
COPY shared/package.json ./shared/
COPY docs/package.json ./docs/

# Install dependencies for all workspaces
RUN bun install
RUN apk add --no-cache curl

# Copy turbo configuration
COPY turbo.json ./

# Copy shared workspace (dependency for dashboard)
COPY shared/ ./shared/

# Build shared workspace first
RUN bunx turbo run build --filter=@discordllmbot/shared

# Copy bot workspace (for any shared types/API)
COPY bot/ ./bot/

# Copy dashboard source
COPY dashboard/ ./dashboard/

# Build dashboard with turbo (uses cache)
RUN bunx turbo run build --filter=discordllmbot-dashboard

# Create .env file with Docker-specific API URL
# Use 'bot' service name from docker-compose for internal networking
# Can be overridden via build arg: --build-arg API_URL=http://bot:3000
ARG API_URL=http://bot:3000
RUN echo "VITE_API_URL=${API_URL}" > ./dashboard/.env

# Increase Vite heap size and disable polling to reduce memory
ENV NODE_OPTIONS="--max-old-space-size=2048"
ENV VITE_WATCH_USE_POLLING=false

WORKDIR /usr/src/app/dashboard
EXPOSE 5173

CMD ["bunx", "turbo", "run", "dev", "--filter=discordllmbot-dashboard"]
