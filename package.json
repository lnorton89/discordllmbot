{
  "name": "discordllmbot-monorepo",
  "version": "1.0.0",
  "packageManager": "bun@1.2.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/lnorton89/discordllmbot.git"
  },
  "workspaces": [
    "bot",
    "dashboard",
    "shared",
    "docs"
  ],
  "description": "Monorepo for DiscordLLMBot, API, and Dashboard",
  "type": "module",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "scripts": {
    "dev": "docker compose up -d bot db dashboard",
    "dev:build": "docker compose up -d --build bot db dashboard",
    "dev:down": "docker compose down",
    "dev:all": "docker compose up -d",
    "dev:logs": "docker compose logs -f",
    "lint": "turbo run lint",
    "lint:bot": "bun --filter discordllmbot run lint",
    "lint:dashboard": "bun --filter discordllmbot-dashboard run lint",
    "lint:shared": "bun --filter @discordllmbot/shared run lint",
    "type-check": "turbo run type-check",
    "type-check:bot": "bun --filter discordllmbot run type-check",
    "type-check:dashboard": "bun --filter discordllmbot-dashboard run type-check",
    "type-check:shared": "bun --filter @discordllmbot/shared run type-check",
    "test": "turbo run test",
    "test:ui": "turbo run test:ui",
    "test:debug": "turbo run test:debug",
    "test:report": "turbo run test:report",
    "build": "turbo run build",
    "build:bot": "turbo run build --filter=discordllmbot",
    "build:dashboard": "turbo run build --filter=discordllmbot-dashboard",
    "build:shared": "turbo run build --filter=@discordllmbot/shared",
    "docs": "bun --filter discordllmbot-docs run dev",
    "docs:generate": "turbo run docs:generate",
    "graph": "bunx madge --image dependency-graph.png --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:svg": "bunx madge --image dependency-graph.svg --layout circo --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:circular": "bunx madge --circular --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:orphans": "bunx madge --orphans --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:tree": "bunx madge --tree index.js bot/src",
    "structure": "bunx project-structure"
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.0.0"
  }
}
