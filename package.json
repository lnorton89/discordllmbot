{
  "name": "discordllmbot-monorepo",
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lnorton89/discordllmbot.git"
  },
  "workspaces": [
    "bot",
    "dashboard",
    "shared",
    "docs"
  ],
  "description": "Monorepo for DiscordLLMBot, API, and Dashboard",
  "type": "module",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "scripts": {
    "dev": "docker compose up -d bot db dashboard",
    "dev:build": "docker compose up -d --build bot db dashboard",
    "dev:down": "docker compose down",
    "dev:all": "docker compose up -d",
    "dev:logs": "docker compose logs -f",
    "lint": "turbo run lint",
    "lint:bot": "npm --prefix ./bot run lint",
    "lint:dashboard": "npm --prefix ./dashboard run lint",
    "lint:shared": "npm --prefix ./shared run lint",
    "type-check": "turbo run type-check",
    "type-check:bot": "npm --prefix ./bot run type-check",
    "type-check:dashboard": "npm --prefix ./dashboard run type-check",
    "type-check:shared": "npm --prefix ./shared run type-check",
    "test": "turbo run test",
    "test:ui": "turbo run test:ui",
    "test:debug": "turbo run test:debug",
    "test:report": "turbo run test:report",
    "build": "turbo run build",
    "build:bot": "turbo run build --filter=discordllmbot",
    "build:dashboard": "turbo run build --filter=discordllmbot-dashboard",
    "build:shared": "turbo run build --filter=@discordllmbot/shared",
    "docs": "npm --prefix ./docs run dev",
    "docs:generate": "turbo run docs:generate",
    "graph": "npx madge --image dependency-graph.png --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:svg": "npx madge --image dependency-graph.svg --layout circo --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:circular": "npx madge --circular --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:orphans": "npx madge --orphans --extensions js,jsx,ts,tsx bot/src dashboard/src shared",
    "graph:tree": "npx madge --tree index.js bot/src",
    "structure": "npx project-structure"
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "turbo": "^2.0.0"
  }
}